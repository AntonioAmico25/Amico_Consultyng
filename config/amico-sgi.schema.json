{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://amico.local/schemas/amico-sgi.schema.json",
  "title": "AMICO SGI Assessment Contract",
  "type": "object",
  "required": ["tenant_id", "client_id", "scope", "frameworks", "method_version", "status"],
  "properties": {
    "tenant_id": {"type": "string", "minLength": 1},
    "client_id": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "frameworks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["ISO9001", "IATF16949", "ISO14001", "ISO45001", "ISO27001", "ISO42001", "LGPD", "INMETRO", "ANVISA"]}
    },
    "method_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["draft", "in_progress", "human_review", "approved", "closed"]},
    "human_approver_id": {"type": ["string", "null"]},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement_id", "applicable", "answer"],
        "properties": {
          "requirement_id": {"type": "string"},
          "applicable": {"type": "boolean"},
          "answer": {"enum": ["conformant", "partial", "nonconformant", "not_assessed"]},
          "score": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
          "justification": {"type": ["string", "null"]},
          "evidence_ids": {"type": "array", "items": {"type": "string"}},
          "human_decision": {"type": "boolean", "const": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
